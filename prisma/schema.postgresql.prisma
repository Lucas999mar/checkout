// Prisma Schema - Checkout Mercado Pago (PostgreSQL Production)
// Sistema completo de pagamentos com PIX, Cartão, Boleto, Assinaturas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(ADMIN)
  avatar        String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?
  imageUrl    String?       @map("image_url")
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  prices       Price[]
  payments     Payment[]
  paymentLinks PaymentLink[]

  @@map("products")
}

model Price {
  id            String      @id @default(uuid())
  productId     String      @map("product_id")
  amount        Float
  currency      String      @default("BRL")
  type          PriceType   @default(ONE_TIME)
  interval      String?
  intervalCount Int?        @default(1) @map("interval_count")
  trialDays     Int?        @default(0) @map("trial_days")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  paymentLinks  PaymentLink[]

  @@map("prices")
}

enum PriceType {
  ONE_TIME
  RECURRING
}

model Customer {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  cpf           String?
  phone         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  payments      Payment[]
  subscriptions Subscription[]

  @@map("customers")
}

model Payment {
  id                    String        @id @default(uuid())
  customerId            String?       @map("customer_id")
  productId             String?       @map("product_id")
  subscriptionId        String?       @map("subscription_id")
  paymentLinkId         String?       @map("payment_link_id")

  mpPaymentId           String?       @unique @map("mp_payment_id")
  mpPreferenceId        String?       @map("mp_preference_id")
  mpStatus              String?       @map("mp_status")
  mpStatusDetail        String?       @map("mp_status_detail")
  mpPaymentMethodId     String?       @map("mp_payment_method_id")
  mpPaymentTypeId       String?       @map("mp_payment_type_id")

  amount                Float
  currency              String        @default("BRL")
  
  pixQrCode             String?       @map("pix_qr_code")
  pixQrCodeBase64       String?       @map("pix_qr_code_base64")
  pixExpirationDate     DateTime?     @map("pix_expiration_date")

  boletoUrl             String?       @map("boleto_url")
  boletoBarcode         String?       @map("boleto_barcode")

  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?     @map("paid_at")
  expiresAt             DateTime?     @map("expires_at")
  
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  customer              Customer?     @relation(fields: [customerId], references: [id])
  product               Product?      @relation(fields: [productId], references: [id])
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  paymentLink           PaymentLink?  @relation(fields: [paymentLinkId], references: [id])

  @@index([mpPaymentId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  IN_PROCESS
  EXPIRED
}

model Subscription {
  id                  String             @id @default(uuid())
  customerId          String             @map("customer_id")
  priceId             String             @map("price_id")

  mpPreapprovalId     String?            @unique @map("mp_preapproval_id")
  mpPreapprovalPlanId String?            @map("mp_preapproval_plan_id")
  mpInitPoint         String?            @map("mp_init_point")

  status              SubscriptionStatus @default(PENDING)
  currentPeriodStart  DateTime?          @map("current_period_start")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  cancelledAt         DateTime?          @map("cancelled_at")
  
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  customer            Customer           @relation(fields: [customerId], references: [id])
  price               Price              @relation(fields: [priceId], references: [id])
  payments            Payment[]

  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  PENDING
  AUTHORIZED
  PAUSED
  CANCELLED
  EXPIRED
}

model PaymentLink {
  id          String            @id @default(uuid())
  productId   String            @map("product_id")
  priceId     String            @map("price_id")
  slug        String            @unique
  
  title       String
  description String?
  
  active      Boolean           @default(true)
  maxUses     Int?              @map("max_uses")
  usedCount   Int               @default(0) @map("used_count")
  expiresAt   DateTime?         @map("expires_at")
  
  acceptPix      Boolean        @default(true) @map("accept_pix")
  acceptCard     Boolean        @default(true) @map("accept_card")
  acceptBoleto   Boolean        @default(true) @map("accept_boleto")
  
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  product     Product           @relation(fields: [productId], references: [id])
  price       Price             @relation(fields: [priceId], references: [id])
  payments    Payment[]

  @@map("payment_links")
}

model WebhookLog {
  id          String    @id @default(uuid())
  source      String
  eventType   String    @map("event_type")
  payload     Json
  processed   Boolean   @default(false)
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("webhook_logs")
}

