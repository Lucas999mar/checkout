# ============================================
# 🏦 BANCO DE DADOS POSTGRESQL (SUPABASE / NEON / RAILWAY)
# ============================================
# No Supabase: Project Settings > Database > Connection String > URI
# Exemplo Supabase:
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================
# 🛡️ MERCADO PAGO PRODUÇÃO OU TESTE
# ============================================
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000

# ============================================
# 🔐 SEGURANÇA E AUTENTICAÇÃO DO PAINEL
# ============================================
JWT_SECRET=super_secret_jwt_checkout_pro_producao_2026_xpto
NEXTAUTH_SECRET=super_secret_jwt_checkout_pro_producao_2026_xpto

# ============================================
# 🌐 URL DA APLICAÇÃO (VERCEL OU DOMÍNIO PRÓPRIO)
# ============================================
NEXT_PUBLIC_APP_URL=https://seu-projeto.vercel.app

# ============================================
# 📡 WEBHOOK DO MERCADO PAGO
# ============================================
WEBHOOK_URL=https://seu-projeto.vercel.app/api/webhooks/mercadopago
